{
  "name": "@headwood/aik-mcp",
  "version": "0.7.1",
  "description": "MCP server for AI knowledge repository (rules, skills, workflows, agents)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "knowledge-base",
    "rules",
    "skills",
    "workflows",
    "agents",
    "templates",
    "llm",
    "opencode",
    "claude-code",
    "cline",
    "aik"
  ],
  "license": "MIT",
  "author": "Olivier Penhoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/aik-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/openhoat/aik-mcp/issues"
  },
  "homepage": "https://openhoat.github.io/aik-mcp/",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "build:changelog": "tsx scripts/changelog.ts",
    "build:docs": "vitepress build docs",
    "build:test": "wireit",
    "clean": "npm run clean:test:coverage && npm run clean:wireit && rimraf build dist",
    "clean:test:coverage": "rimraf dist/coverage",
    "clean:wireit": "rimraf .wireit",
    "postversion": "git push --follow-tags",
    "prepare": "husky",
    "prepublishOnly": "npm run validate",
    "preversion": "npm run validate",
    "qa": "wireit",
    "qa:arch": "wireit",
    "qa:biome": "wireit",
    "qa:biome:fix": "biome check --write --unsafe .",
    "qa:fix": "npm run qa:biome:fix && npm run qa:markdown:fix && npm run qa:prettier:fix",
    "qa:markdown": "wireit",
    "qa:markdown:fix": "markdownlint-cli2 --fix",
    "qa:markdown:rag": "wireit",
    "qa:prettier": "wireit",
    "qa:prettier:fix": "prettier --write \"**/*.md\"",
    "sonar": "wireit",
    "start": "node build/index.js",
    "start:docs": "vitepress dev docs",
    "start:docs:preview": "vitepress preview docs",
    "start:mcp:inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:coverage:open": "open-cli dist/coverage/lcov-report/index.html",
    "test:e2e": "wireit",
    "test:unit": "wireit",
    "test:watch": "vitest",
    "typecheck": "wireit",
    "validate": "wireit",
    "version": "npm run build:changelog && git add -A"
  },
  "bin": {
    "aik-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "files": [
    "build",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "LICENSE",
    "README.md"
  ],
  "main": "build/index.js",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.20.0"
  },
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.build.json && cp -r src/built-in build/built-in",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/test/**",
        "src/built-in/**/*",
        "tsconfig.build.json",
        "tsconfig.json"
      ],
      "output": [
        "build/**"
      ]
    },
    "build:test": {
      "command": "tsc -p tsconfig.test.json",
      "files": [
        "src/**/*.ts",
        "tsconfig.test.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "qa": {
      "dependencies": [
        "qa:arch",
        "qa:biome",
        "qa:markdown",
        "qa:markdown:rag",
        "qa:prettier"
      ]
    },
    "qa:biome": {
      "command": "biome check .",
      "files": [
        "src/**/*.ts",
        "scripts/**/*.mjs",
        "*.{cjs,mjs,json}",
        "*.ts",
        "biome.json"
      ],
      "output": []
    },
    "qa:arch": {
      "command": "depcruise src",
      "files": [
        "src/**/*.ts",
        ".dependency-cruiser.mjs"
      ],
      "output": []
    },
    "qa:markdown": {
      "command": "markdownlint-cli2",
      "files": [
        "**/*.md",
        "!node_modules",
        "!.npm",
        "!build",
        "!dist",
        "!rag"
      ],
      "output": []
    },
    "qa:markdown:rag": {
      "command": "markdownlint-cli2 --config rag/.markdownlint-cli2.yaml \"rag/**/*.md\"",
      "files": [
        "rag/**/*.md",
        "rag/.markdownlint-cli2.yaml"
      ],
      "output": []
    },
    "qa:prettier": {
      "command": "prettier --check \"**/*.md\"",
      "files": [
        "**/*.md",
        "!CHANGELOG.md",
        "!build",
        "!dist",
        "!.wireit",
        "!rag",
        ".prettierignore"
      ],
      "output": []
    },
    "sonar": {
      "command": "sonar-scanner-npm",
      "dependencies": [
        "test:coverage"
      ]
    },
    "test": {
      "dependencies": [
        "test:unit"
      ]
    },
    "test:coverage": {
      "command": "vitest run --project unit --coverage",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/coverage/**"
      ]
    },
    "test:e2e": {
      "command": "vitest run --project e2e",
      "dependencies": [
        "build"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "test:unit": {
      "command": "vitest run --project unit",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "typecheck": {
      "command": "tsc -p tsconfig.typecheck.json --noEmit",
      "files": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "tsconfig.typecheck.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "validate": {
      "dependencies": [
        "build",
        "qa",
        "test:coverage",
        "test:e2e",
        "typecheck"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "chokidar": "5.0.0",
    "comment-json": "5.0.0",
    "fuse.js": "7.5.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@swc/core": "1.16.13",
    "@types/comment-json": "2.4.5",
    "@types/node": "26.6.4",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.3",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-cli": "5.0.0",
    "conventional-commits-filter": "6.0.1",
    "conventional-commits-parser": "7.1.2",
    "dependency-cruiser": "18.5.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.3",
    "open-cli": "9.0.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "sonarqube-scanner": "5.0.1",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.0.3",
    "wireit": "0.14.13"
  }
}
