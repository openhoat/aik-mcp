# aik-mcp environment variables
# Copy this file to .env.local and adjust the values.

# Directory scanned for AI knowledge content (rules, skills, workflows, agents).
# Default: current working directory.
AIK_CONTENT_DIR=

# Runtime environment: development or production.
# Production switches logging to JSON output on stderr.
# Default: development
NODE_ENV=

# Pino log level (trace, debug, info, warn, error, fatal).
# Default: info in production, trace otherwise.
LOG_LEVEL=

# Overrides the Codex CLI global configuration directory used when installing
# content for the Codex agent.
# Default: ~/.codex
CODEX_HOME=
